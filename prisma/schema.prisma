generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
}

model Organization {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  ownerId   String @unique

  // Lifecycle: ONBOARDING (created, no active subscription yet) -> ACTIVE
  // (subscription activated) -> SUSPENDED (super admin cutoff). Doesn't
  // replace the Subscription.status check — an org can be ACTIVE here while
  // its subscription has separately lapsed; that's checked independently.
  status    OrganizationStatus @default(ONBOARDING)
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  owner     User @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users     User[] @relation("OrganizationUsers")
  // One subscription per org, ever — updated in place on renew/upgrade/
  // downgrade, never a second row. SubscriptionHistory is the change log.
  subscription  Subscription?
  payments  Payment[]
  // Custom plans negotiated for this org only — never set for PUBLIC plans.
  customPlans Plan[]
  quoteRequests QuoteRequest[]
  projects      Project[]
  trackingSettings OrganizationTrackingSettings?
}

enum OrganizationStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model User{
  id                 String   @id @default(uuid())
  // Nullable — a self-registering owner exists before any org does; an
  // invited user always has both set immediately at creation instead.
  organizationId     String?
  roleId             String?

  email              String   @unique
  // Null until the user completes email verification (self-registration) or
  // accepts their invite (added by an owner) — both flows set a real
  // password for the first time via the token below, never before.
  passwordHash       String?

  // Single-use, expiring token backing both "verify your own email" and
  // "accept your invite" — same mechanism, same fields, either origin.
  verificationToken            String?   @unique
  verificationTokenExpiresAt   DateTime?

  firstName          String
  lastName           String
  displayName        String?

  phone              String?
  avatarUrl          String?

  timezone           String   @default("UTC")
  locale             String   @default("en")

  isActive           Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  emailVerifiedAt    DateTime?

  lastLoginAt        DateTime?
  lastLoginIp        String?

  passwordChangedAt  DateTime?

  createdAt          DateTime @default(now())
  createdBy          String?
  updatedAt          DateTime @updatedAt
  updatedBy          String?

  organization       Organization? @relation("OrganizationUsers", fields: [organizationId], references: [id])
  // Org-wide role only (ORGANIZATION_ADMIN, HR) — project-scoped roles
  // (PROJECT_MANAGER, TEAM_LEAD, COORDINATOR, QA, EMPLOYEE) live on
  // ProjectMember instead, never here. ORGANIZATION_ADMIN also always has
  // full access to every project in their org regardless of ProjectMember
  // rows — enforced in the guard, not representable in the schema.
  role               Role? @relation(fields: [roleId], references: [id])
  // Opposite side of Organization.owner — only set for the one user who owns an org.
  ownedOrganization  Organization? @relation("OrganizationOwner")

  projectMemberships ProjectMember[]
  assignedTasks       Task[]
  timeEntries         TimeEntry[]
  timeEntryRequests   TimeEntryRequest[]
  notifications       Notification[]
  taskComments        TaskComment[]
  teamMemberships     TeamMember[]
  screenshots         Screenshot[]

  @@index([organizationId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  projectMemberships ProjectMember[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?

  basePrice    Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  billingCycle BillingCycle

  isActive     Boolean  @default(true)

  // PUBLIC: visible to every organization, activates directly.
  // CUSTOM: visible/purchasable only by organizationId below.
  visibility     PlanVisibility @default(PUBLIC)
  // Set only when visibility = CUSTOM — the one org this plan was negotiated for.
  organizationId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entitlements       PlanEntitlement[]
  subscriptions      Subscription[]
  organization       Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlanVisibility {
  PUBLIC
  CUSTOM
}

model PlanEntitlement {
  id        String   @id @default(uuid())
  planId    String

  feature   String
  value     String

  plan      Plan     @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, feature])
}

// A "request a quote" form submission or "call us" log entry — the path
// toward a Super Admin manually creating a CUSTOM Plan for this org after
// negotiating a price off-platform. Not a plan or subscription itself.
model QuoteRequest {
  id             String             @id @default(uuid())
  organizationId String

  notes          String?
  contactPhone   String?
  source         QuoteRequestSource
  status         QuoteRequestStatus @default(PENDING)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum QuoteRequestSource {
  FORM
  CALL
}

enum QuoteRequestStatus {
  PENDING
  CONTACTED
  RESOLVED
}

model Subscription {
  id                     String   @id @default(uuid())
  // Unique — at most one subscription per org, ever. Renewing/changing plan
  // updates this same row; it never gets a second one.
  organizationId         String   @unique
  planId                 String

  status                 SubscriptionStatus
  billingCycle           BillingCycle

  basePrice              Decimal  @db.Decimal(10, 2)
  discountType           DiscountType?
  discountValue          Decimal? @db.Decimal(10, 2)
  additionalCharge       Decimal  @default(0) @db.Decimal(10, 2)
  finalPrice             Decimal  @db.Decimal(10, 2)

  startDate              DateTime
  endDate                DateTime?

  cancelAtPeriodEnd      Boolean  @default(false)

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id])
  plan                   Plan         @relation(fields: [planId], references: [id])
  history                SubscriptionHistory[]
  payments               Payment[]

  @@index([planId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String

  action         String

  oldPlanId      String?
  newPlanId      String?

  oldPrice       Decimal? @db.Decimal(10, 2)
  newPrice       Decimal? @db.Decimal(10, 2)

  reason         String?
  changedBy      String?

  createdAt      DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())

  actorType      String
  actorId        String?

  organizationId String?

  action         String
  entityType     String
  entityId       String?

  description    String?
  metadata       Json?

  ipAddress      String?
  userAgent      String?

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Payment {
  id                    String   @id @default(uuid())

  organizationId        String
  subscriptionId        String

  amount                Decimal  @db.Decimal(10, 2)
  currency              String   @default("USD")

  status                PaymentStatus
  paymentMethod         String?

  provider              String?
  providerPaymentId     String?
  providerCustomerId    String?

  invoiceId             String?

  paidAt                DateTime?

  failureReason         String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id])
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([providerPaymentId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELED
}

// --- Phase 2: Projects, Tasks, Time Tracking, Notifications ----------------

model Project {
  id             String        @id @default(uuid())
  organizationId String

  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)

  createdAt      DateTime      @default(now())
  createdBy      String
  updatedAt      DateTime      @updatedAt
  updatedBy      String

  organization   Organization    @relation(fields: [organizationId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
  teams          Team[]

  @@index([organizationId])
}

// A sub-grouping of project members, scoped under one or more team leads —
// what a TEAM_LEAD's task visibility and assignment authority is limited
// to (they can only see/assign within teams they lead, not the whole
// project — that's PROJECT_MANAGER's scope).
model Team {
  id        String   @id @default(uuid())
  projectId String
  name      String

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  project   Project      @relation(fields: [projectId], references: [id])
  members   TeamMember[]

  @@index([projectId])
}

model TeamMember {
  id      String  @id @default(uuid())
  teamId  String
  userId  String
  // Multiple leads per team are allowed — "the tech lead" isn't assumed to
  // be exactly one person.
  isLead  Boolean @default(false)

  addedAt DateTime @default(now())
  addedBy String

  team    Team @relation(fields: [teamId], references: [id])
  user    User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// A user's role is scoped to one project at a time — the same person can be
// PROJECT_MANAGER on one project, EMPLOYEE on another, and absent from a
// third. Never used for org-wide checks (see User.role for that).
// ORGANIZATION_ADMIN doesn't need a row here — they always have full access
// to every project in their org, enforced in the guard regardless of
// membership rows.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  roleId    String

  addedAt   DateTime @default(now())
  addedBy   String

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  // Self-relation for subtasks — null parentId = top-level task.
  parentId    String?
  // 0, 1, or 2 — three levels max, enforced in the service layer (Prisma
  // has no native "max hierarchy depth" constraint) when creating a subtask
  // under a depth-2 parent.
  depth       Int          @default(0)

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId  String?
  // Hubstaff-style date range — startDate is the range's beginning, dueDate
  // (kept as-is rather than renamed to endDate, to avoid touching every
  // existing caller) is the range's end. Both optional and independent: a
  // task can have just a due date, just a start date, both, or neither.
  // Range ordering (startDate <= dueDate) is enforced in TasksService, not
  // here — Prisma has no cross-column check constraint.
  startDate   DateTime?
  dueDate     DateTime?
  // Estimated effort, 1 minute to 480 (8 hours) — validated in the DTOs, not
  // enforced here. Distinct from TimeEntry, which is actual tracked time
  // (Phase 3, desktop app). No default — null means "this is a container
  // task, break it into subtasks"; a real value means "atomic unit of work,
  // no subtasks allowed". The two are mutually exclusive, enforced in
  // TasksService (setting one is blocked once the other is true).
  estimatedMinutes Int?

  createdAt   DateTime     @default(now())
  createdBy   String
  updatedAt   DateTime     @updatedAt
  updatedBy   String

  project     Project     @relation(fields: [projectId], references: [id])
  parent      Task?       @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks    Task[]      @relation("TaskSubtasks")
  assignee    User?       @relation(fields: [assigneeId], references: [id])
  // Only valid when this task currently has no subtasks — enforced in the
  // service layer at time-entry creation, not representable in the schema
  // (leaf-ness can change over time as subtasks are added/removed).
  timeEntries TimeEntry[]
  timeEntryRequests TimeEntryRequest[]
  comments    TaskComment[]
  screenshots Screenshot[]

  @@index([projectId])
  @@index([parentId])
  @@index([assigneeId])
}

// A task's discussion thread — any project member can post, no separate
// permission gate (same access level as viewing the task itself).
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  body      String

  // Users explicitly @mentioned in this comment (via the composer's
  // autocomplete, not parsed out of the text) — drives the TASK_MENTION
  // notification and lets the frontend highlight "@Name" back to a real
  // person when rendering. No join table: a plain id array is enough since
  // nothing needs to query "comments mentioning user X" yet.
  mentionedUserIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task @relation(fields: [taskId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  @@index([taskId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String
  userId      String

  startedAt   DateTime
  // null = timer currently running. A user can only have one running timer
  // at a time — starting a new one auto-stops whichever is already running.
  endedAt     DateTime?
  durationSec Int?
  note        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task @relation(fields: [taskId], references: [id])
  user        User @relation(fields: [userId], references: [id])
  screenshots Screenshot[]
  // Set once the request that created this entry (if any) is approved — a
  // live-tracked entry (desktop start/stop) has no request at all.
  request     TimeEntryRequest?

  @@index([taskId])
  @@index([userId])
}

enum TimeRequestStatus {
  SUBMITTED
  APPROVED
  DENIED
}

// A manually-entered time span awaiting sign-off before it counts as real
// tracked time — Hubstaff calls this "Manual Time Requests". Who can
// approve one is a hierarchy, not a fixed permission: anyone ranked above
// the submitter *within that project* (see ROLE_RANK in
// time-entry-requests.service.ts), or the org admin unconditionally. An
// admin's own submission skips this table's pending state entirely — it's
// created here already APPROVED, with `timeEntryId` set immediately — so
// the "my requests" history view has one consistent place to look
// regardless of whether review was actually needed.
model TimeEntryRequest {
  id          String            @id @default(uuid())
  taskId      String
  userId      String

  startedAt   DateTime
  endedAt     DateTime
  note        String?

  status      TimeRequestStatus @default(SUBMITTED)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?

  timeEntryId String?           @unique
  timeEntry   TimeEntry?        @relation(fields: [timeEntryId], references: [id])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  task        Task @relation(fields: [taskId], references: [id])
  user        User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([status])
}

// The dashboard's "inbox" feed — generated server-side on events like task
// assignment or status changes, not user-authored.
model Notification {
  id         String   @id @default(uuid())
  userId     String

  type       String
  title      String
  message    String?

  entityType String?
  entityId   String?

  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// Per-org configuration for the desktop time-tracker's idle-discard and
// screenshot behavior — one row per org, auto-created with defaults on
// first read. Editable only by ORGANIZATION_ADMIN (tracking.settings.manage).
model OrganizationTrackingSettings {
  id                   String @id @default(uuid())
  organizationId       String @unique

  // Seconds of OS-level inactivity before the desktop app prompts to
  // discard the idle stretch. Range 15–900 (15s–15min), DTO-validated.
  idleThresholdSec     Int    @default(300)
  // How often the desktop app captures a screenshot while a timer is
  // running. Range 5–900 (5s–15min), DTO-validated.
  screenshotIntervalSec Int   @default(300)

  updatedAt DateTime @updatedAt
  updatedBy String

  organization Organization @relation(fields: [organizationId], references: [id])
}

// A screenshot captured by the desktop app while a timer was running.
// Stored on local disk under a `screenshots/` folder at the backend's
// project root (no third-party storage) — filePath is relative to that
// folder, never served statically; only via the authenticated stream
// endpoint in ScreenshotsController.
model Screenshot {
  id             String   @id @default(uuid())
  timeEntryId    String
  taskId         String
  userId         String
  organizationId String

  filePath       String
  takenAt        DateTime @default(now())
  createdAt      DateTime @default(now())

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id])
  task      Task      @relation(fields: [taskId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([timeEntryId])
  @@index([taskId])
  @@index([userId])
}