generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
}

model Organization {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  ownerId   String @unique

  // Lifecycle: ONBOARDING (created, no active subscription yet) -> ACTIVE
  // (subscription activated) -> SUSPENDED (super admin cutoff). Doesn't
  // replace the Subscription.status check — an org can be ACTIVE here while
  // its subscription has separately lapsed; that's checked independently.
  status    OrganizationStatus @default(ONBOARDING)
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  owner     User @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users     User[] @relation("OrganizationUsers")
  // One subscription per org, ever — updated in place on renew/upgrade/
  // downgrade, never a second row. SubscriptionHistory is the change log.
  subscription  Subscription?
  payments  Payment[]
  // Custom plans negotiated for this org only — never set for PUBLIC plans.
  customPlans Plan[]
  quoteRequests QuoteRequest[]
}

enum OrganizationStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model User{
  id                 String   @id @default(uuid())
  // Nullable — a self-registering owner exists before any org does; an
  // invited user always has both set immediately at creation instead.
  organizationId     String?
  roleId             String?

  email              String   @unique
  // Null until the user completes email verification (self-registration) or
  // accepts their invite (added by an owner) — both flows set a real
  // password for the first time via the token below, never before.
  passwordHash       String?

  // Single-use, expiring token backing both "verify your own email" and
  // "accept your invite" — same mechanism, same fields, either origin.
  verificationToken            String?   @unique
  verificationTokenExpiresAt   DateTime?

  firstName          String
  lastName           String
  displayName        String?

  phone              String?
  avatarUrl          String?

  timezone           String   @default("UTC")
  locale             String   @default("en")

  isActive           Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  emailVerifiedAt    DateTime?

  lastLoginAt        DateTime?
  lastLoginIp        String?

  passwordChangedAt  DateTime?

  createdAt          DateTime @default(now())
  createdBy          String?
  updatedAt          DateTime @updatedAt
  updatedBy          String?

  organization       Organization? @relation("OrganizationUsers", fields: [organizationId], references: [id])
  role               Role? @relation(fields: [roleId], references: [id])
  // Opposite side of Organization.owner — only set for the one user who owns an org.
  ownedOrganization  Organization? @relation("OrganizationOwner")

  @@index([organizationId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?

  basePrice    Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  billingCycle BillingCycle

  isActive     Boolean  @default(true)

  // PUBLIC: visible to every organization, activates directly.
  // CUSTOM: visible/purchasable only by organizationId below.
  visibility     PlanVisibility @default(PUBLIC)
  // Set only when visibility = CUSTOM — the one org this plan was negotiated for.
  organizationId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entitlements       PlanEntitlement[]
  subscriptions      Subscription[]
  organization       Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlanVisibility {
  PUBLIC
  CUSTOM
}

model PlanEntitlement {
  id        String   @id @default(uuid())
  planId    String

  feature   String
  value     String

  plan      Plan     @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, feature])
}

// A "request a quote" form submission or "call us" log entry — the path
// toward a Super Admin manually creating a CUSTOM Plan for this org after
// negotiating a price off-platform. Not a plan or subscription itself.
model QuoteRequest {
  id             String             @id @default(uuid())
  organizationId String

  notes          String?
  contactPhone   String?
  source         QuoteRequestSource
  status         QuoteRequestStatus @default(PENDING)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum QuoteRequestSource {
  FORM
  CALL
}

enum QuoteRequestStatus {
  PENDING
  CONTACTED
  RESOLVED
}

model Subscription {
  id                     String   @id @default(uuid())
  // Unique — at most one subscription per org, ever. Renewing/changing plan
  // updates this same row; it never gets a second one.
  organizationId         String   @unique
  planId                 String

  status                 SubscriptionStatus
  billingCycle           BillingCycle

  basePrice              Decimal  @db.Decimal(10, 2)
  discountType           DiscountType?
  discountValue          Decimal? @db.Decimal(10, 2)
  additionalCharge       Decimal  @default(0) @db.Decimal(10, 2)
  finalPrice             Decimal  @db.Decimal(10, 2)

  startDate              DateTime
  endDate                DateTime?

  cancelAtPeriodEnd      Boolean  @default(false)

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id])
  plan                   Plan         @relation(fields: [planId], references: [id])
  history                SubscriptionHistory[]
  payments               Payment[]

  @@index([planId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String

  action         String

  oldPlanId      String?
  newPlanId      String?

  oldPrice       Decimal? @db.Decimal(10, 2)
  newPrice       Decimal? @db.Decimal(10, 2)

  reason         String?
  changedBy      String?

  createdAt      DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())

  actorType      String
  actorId        String?

  organizationId String?

  action         String
  entityType     String
  entityId       String?

  description    String?
  metadata       Json?

  ipAddress      String?
  userAgent      String?

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Payment {
  id                    String   @id @default(uuid())

  organizationId        String
  subscriptionId        String

  amount                Decimal  @db.Decimal(10, 2)
  currency              String   @default("USD")

  status                PaymentStatus
  paymentMethod         String?

  provider              String?
  providerPaymentId     String?
  providerCustomerId    String?

  invoiceId             String?

  paidAt                DateTime?

  failureReason         String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id])
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([providerPaymentId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELED
}