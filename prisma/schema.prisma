// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Task {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  timeEntries TimeEntry[]

  @@index([projectId])
}

model TimeEntry {
  id              String    @id @default(cuid())
  // Placeholder for future auth — unused for now, kept nullable so a real
  // user id can be filled in later without a schema migration.
  userId          String?
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  // Which client wrote this entry: "web" (manual edit) or "desktop" (timer).
  source          String    @default("web")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([endedAt])
}

model AppSettings {
  // Single-row config table — no auth/users yet, so this is one global
  // setting rather than per-user. "singleton" is a fixed id, not generated,
  // so there is never more than one row to look up.
  id                 String   @id @default("singleton")
  // How many minutes of no keyboard/mouse activity before the desktop app
  // auto-stops the running timer and discards that idle stretch.
  idleTimeoutMinutes Int      @default(5)
  updatedAt          DateTime @updatedAt
}
